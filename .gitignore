# C/C++ build outputs
# =========================

# executable files
/main
*.out
*.exe
*.app

# object files / libraries
*.o
*.obj
*.a
*.so
*.dll
*.dylib

# build directories
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
Makefile
compile_commands.json

